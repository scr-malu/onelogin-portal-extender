{
    "manifest_version": 3,
    "name": "OneLogin Portal Extender",
    "version": "1.1.0",
    "author": "scr-malu",
    "description": "OneLoginのポータル画面で初期表示タブの切り替え(タブ名の自動検出/指定)、アプリのピン留め、対象ドメインの限定ができます。",
    "content_scripts": [{
        "matches": [
          "https://*.onelogin.com/portal",
          "https://*.onelogin.com/portal/*"
        ],
        "run_at": "document_start",
        "js": [
          "portal-01.js"
        ],
        "css": [
          "portal-01.css"
        ]
    }],
    "permissions": ["storage"],
    "options_ui": {
    "page": "options.html",
    "open_in_tab": true
    },
    "icons": {
        "128": "icon-extender.png"
    }
  }
